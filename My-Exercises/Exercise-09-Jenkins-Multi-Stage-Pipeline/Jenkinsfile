pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh '''
                    set -eu
                    python3 -m venv .venv
                    .venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -eu
                    deploy_dir="${WORKSPACE}/python-app-deploy"
                    mkdir -p "$deploy_dir"
                    cp app.py requirements.txt verify_deployment.py "$deploy_dir/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                sh '''
set -eu
deploy_dir="${WORKSPACE}/python-app-deploy"
.venv/bin/python "$deploy_dir/app.py" > "$deploy_dir/app.log" 2>&1 &
app_pid=$!
trap 'kill "$app_pid" 2>/dev/null || true; wait "$app_pid" 2>/dev/null || true' EXIT

.venv/bin/python "$deploy_dir/verify_deployment.py"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
